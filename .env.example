# Copy this file to .env, generate a unique SECRET_KEY, and set local credentials.
SECRET_KEY=REPLACE_WITH_RANDOM_GENERATED_SECRET
DEBUG=True
VISITA_DEBUG=True
DB_NAME=visita_db
DB_USER=visita_user
DB_PASSWORD=REPLACE_WITH_YOUR_POSTGRESQL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
# Use require for Supabase; prefer permits a local PostgreSQL installation.
DB_SSLMODE=prefer
# Separate database used only by the automated tests.
DB_TEST_NAME=test_visita_phase1
